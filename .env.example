# Required
DISCORD_BOT_TOKEN=
# Service token, sent as "Authorization: Bearer <token>" on every API call
BOT_API_TOKEN=

# Optional
OPENCAPPER_API_URL=https://opencapper.coding-global.com/api
# Registers slash commands on this guild only (instant), instead of globally
DEV_GUILD_ID=
BOT_NAME=OpenCapper
WEBSITE_URL=https://opencapper.coding-global.com
BOT_ACTIVITY=
LOG_LEVEL=info
# Settled picks are posted to the first text channel whose name contains this
RESULTS_CHANNEL=results
# Results feed watermarks; a docker volume in production
DATA_DIR=/app/data
